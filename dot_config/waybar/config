{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "temperature", "memory", "disk", "pulseaudio", "network", "backlight", "battery", "tray", "custom/lock"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}"
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1"
    },
    "clock": {
        "interval": 1,
        "format": "  {:%d/%m/%Y %H:%M:%S}",
        "timezone": "Europe/London",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>"
    },
    "custom/music": {
        "format": "♪  {}",
        "escape": true,
        "interval": 5,
        "tooltip": false,
        "exec": "playerctl metadata --format='{{ artist }} — {{ title }}'",
        "on-click": "playerctl play-pause",
        "max-length": 60
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },
    "cpu": {
        "interval": 10,
        "format": " {usage}%",
        "max-length": 10
    },
    "temperature": {
        "thermal-zone": 10,
        "format": " {temperatureC}°C"
    },
    "memory": {
        "interval": 30,
        "format": " {avail}GiB",
        "max-length": 11,
        "tooltip": true,
        "tooltip-format": "{percentage}% used"
    },
    "disk": {
        "interval": 30,
        "format": " {free}",
        "path": "/"
    },
    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": " {ifname}",
        "format-linked": "",
        "format-disconnected": "⚠",
        "format-alt": "{ipaddr}/{cidr} - Signal Strength: {signalStrength}%"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon}  {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", " "]
        }
    },
    "custom/lock": {
        "tooltip": false,
        "on-click": "/home/ali/.config/hypr/power-menu.sh",
        "format": ""
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
