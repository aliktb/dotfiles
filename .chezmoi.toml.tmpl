mode = "symlink"

[edit]
  watch = true

[data]
{{- if eq .chezmoi.os "darwin" }}
  omz_dir = "~/.oh-my-zsh"

{{- else if eq .chezmoi.os "linux" }}
  {{- $osid := index .chezmoi.osRelease "id" | default "" -}}
  {{- if eq $osid "arch" }}
  omz_dir = "/usr/share/oh-my-zsh"
  {{- else if eq $osid "fedora" }}
  omz_dir = "~/.oh-my-zsh"
  {{- end }}
{{- end }}
